{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["RUSTUP_HOME", "CARGO_HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@soundor/components-website#build": {
      "dependsOn": ["^build"],
      "env": ["SITE_BASE_PATH"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH"],
      "cache": false
    },
    "test:vst3": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "DISPLAY", "XAUTHORITY"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@soundor/components-demos#build": {
      "dependsOn": ["^build"],
      "outputs": [".soundor/dist/**"]
    }
  }
}
