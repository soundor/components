{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@soundor/components-website#build": {
      "dependsOn": ["^build"],
      "env": ["SITE_BASE_PATH"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@soundor/components-demos#build": {
      "dependsOn": ["^build"],
      "outputs": [".soundor/dist/**"]
    }
  }
}
